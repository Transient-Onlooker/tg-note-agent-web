{
  "name": "note-relay",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "web",
    "worker",
    "shared"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace web",
    "dev:worker": "npm run dev --workspace worker",
    "build:web": "npm run build --workspace web",
    "typecheck:worker": "npm run typecheck --workspace worker"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260825.1": true
  }
}
